<Window x:Class="STM32CubeMX.ChinesePatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STM32CubeMX.ChinesePatcher"
        mc:Ignorable="d"
        Title="STM32CubeMX 汉化工具"
        Width="1060"
        Height="760"
        MinWidth="1060"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="122" />
        </Style>
        <Style x:Key="HeaderMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#164F7D" />
            <Setter Property="BorderBrush" Value="#477BA2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20638F" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6AA7C9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0F416B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="34"
                           Foreground="#47C4F1"
                           Text="&#xE774;" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="STM32CubeMX 汉化工具" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#B9D7E8"
                               Text="本机补丁管理" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="AboutButton"
                            Margin="0,0,20,0"
                            AutomationProperties.Name="关于"
                            Style="{StaticResource HeaderMenuButtonStyle}"
                            ToolTip="打开关于菜单"
                            Click="AboutButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AboutMenu"
                                         MinWidth="176"
                                         Padding="4"
                                         Background="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         BorderThickness="1"
                                         HasDropShadow="True">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="关于本软件" Click="AboutMenuItem_Click">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="检查更新" Click="CheckUpdatesMenuItem_Click">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE946;" />
                            <TextBlock VerticalAlignment="Center" Text="关于" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE70D;" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="#B9D7E8"
                                   Text="PATCHER" />
                        <TextBlock Margin="0,3,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding AppVersion, StringFormat=v{0}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Width="1000"
                    HorizontalAlignment="Center"
                    Padding="30,24,30,26">
            <Grid Width="940">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Width="112" VerticalAlignment="Center">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="安装目录" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding DetectionSourceText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Height="42"
                                Margin="0,0,10,0"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Background="#F7FAFC"
                                BorderBrush="#C9D8E1"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="{Binding PathDisplay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PathDisplay}" />
                        </Border>
                        <Button Grid.Column="2"
                                Margin="0,0,10,0"
                                IsEnabled="{Binding CanBrowse}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="手动选择 STM32CubeMX 安装目录"
                                Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE8B7;" />
                                <TextBlock Text="浏览" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="重新自动检测">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Text="&#xE72C;" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="CubeMX 版本" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,9,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NavyBrush}"
                                       Text="{Binding CubeVersion}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding VersionDetail}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource StatusCardStyle}"
                            Background="{Binding RunningSurface}"
                            BorderBrush="{Binding RunningAccent}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="运行状态" />
                            <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal">
                                <TextBlock Margin="0,0,9,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{Binding RunningAccent}"
                                           Text="{Binding RunningIcon}" />
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RunningAccent}"
                                           Text="{Binding RunningValue}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding RunningDetail}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource StatusCardStyle}"
                            Background="{Binding LocalizationSurface}"
                            BorderBrush="{Binding LocalizationAccent}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="汉化状态" />
                            <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal">
                                <TextBlock Margin="0,0,9,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{Binding LocalizationAccent}"
                                           Text="{Binding LocalizationIcon}" />
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding LocalizationAccent}"
                                           Text="{Binding LocalizationValue}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding LocalizationDetail}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,18,0,0"
                        Padding="18"
                        Background="#EAF5FB"
                        BorderBrush="#A9D4E8"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="4"
                                Margin="0,2,0,2"
                                HorizontalAlignment="Left"
                                Background="{Binding StatusAccent}"
                                CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="当前状态" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusAccent}"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="148"
                                    Margin="0,0,10,0"
                                    Command="{Binding RollbackCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="移除本工具管理的汉化启动项">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE7A7;" />
                                    <TextBlock Text="一键回退" />
                                </StackPanel>
                            </Button>
                            <Button Width="160"
                                    Command="{Binding ApplyCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="安装或更新中文界面补丁">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE8FB;" />
                                    <TextBlock Text="{Binding ApplyButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3"
                      Margin="2,8,2,0"
                      Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="{StaticResource CyanBrush}"
                                 Background="#DDE8EE" />
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding ProgressText}" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,14,0,0" MinHeight="170">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="操作记录" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="最近 100 条" />
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,9,0,0"
                            Background="White"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListBox ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   Foreground="#7A8993"
                                                   Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding LevelColor}"
                                                   Text="{Binding Level}" />
                                        <TextBlock Grid.Column="2"
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#EDF2F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <TextBlock VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="STM32CubeMX 是 STMicroelectronics 的注册商标" />
            </Grid>
        </Border>
    </Grid>
</Window>
