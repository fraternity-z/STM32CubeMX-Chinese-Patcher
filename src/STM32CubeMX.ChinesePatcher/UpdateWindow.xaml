<Window x:Class="STM32CubeMX.ChinesePatcher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="600"
        Height="570"
        MinWidth="600"
        MinHeight="520"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="28"
                           Foreground="#47C4F1"
                           Text="&#xE895;" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="发现可用更新" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="#B9D7E8"
                               Text="已通过官方发布渠道获取" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="{Binding VersionText}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,18">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           Text="更新内容" />
                <Border Margin="0,9,0,0"
                        Padding="14"
                        MinHeight="150"
                        MaxHeight="230"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="{Binding ReleaseNotes}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           Text="更新包" />
                <Border Margin="0,9,0,0"
                        Padding="14"
                        Background="#F7FAFC"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="文件" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="{Binding PackageName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PackageName}" />
                        <TextBlock Grid.Row="1" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="大小" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Foreground="{StaticResource InkBrush}" Text="{Binding PackageSize}" />
                        <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="SHA-256" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,7,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="{Binding Checksum}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Checksum}" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,16,0,0">
                    <ProgressBar Height="5"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="{StaticResource CyanBrush}"
                                 Background="#DDE8EE" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding ProgressText}" />
                    <TextBlock Margin="0,8,0,0"
                               Padding="10"
                               Background="#FFF1F0"
                               Foreground="#B42318"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="查看发布页面"
                        Click="ReleasePageButton_Click" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="112"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanCancelDownload}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="取消下载"
                            Click="CancelButton_Click" />
                    <Button Width="112"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanStartDownload}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="稍后处理"
                            Click="LaterButton_Click" />
                    <Button Width="128"
                            IsEnabled="{Binding CanStartDownload}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="立即更新"
                            Click="UpdateButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
