<Window x:Class="STM32CubeMX.ChinesePatcher.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="590"
        Height="600"
        MinWidth="590"
        MinHeight="520"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="28"
                           Foreground="#47C4F1"
                           Text="&#xE946;" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="关于本软件" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="#B9D7E8"
                               Text="STM32CubeMX 汉化工具" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="{Binding CurrentVersionText}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="STM32CubeMX 汉化工具" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="本机 STM32CubeMX 界面汉化与补丁管理" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="11,6"
                            VerticalAlignment="Center"
                            Background="#EAF5FB"
                            BorderBrush="#A9D4E8"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}"
                                   Text="{Binding CurrentVersionText}" />
                    </Border>
                </Grid>

                <Border Margin="0,20,0,0"
                        Padding="16"
                        Background="{Binding StatusSurface}"
                        BorderBrush="{Binding StatusAccent}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,1,13,0"
                                   VerticalAlignment="Top"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="21"
                                   Foreground="{Binding StatusAccent}"
                                   Text="{Binding StatusIcon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusAccent}"
                                       Text="{Binding StatusTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="12"
                                       LineHeight="19"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ProgressBar Height="5"
                             Margin="0,10,0,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource CyanBrush}"
                             Background="#DDE8EE"
                             Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Margin="0,18,0,0"
                        Padding="16"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="更新说明" />
                            <TextBlock Grid.Column="1"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NavyBrush}"
                                       Text="{Binding LatestVersionText}" />
                        </Grid>
                        <ScrollViewer MaxHeight="180"
                                      Margin="0,11,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock FontSize="12"
                                       LineHeight="19"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="{Binding ReleaseNotes}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left"
                        MinWidth="128"
                        AutomationProperties.Name="{Binding CheckButtonText}"
                        Command="{Binding CheckCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Text="&#xE895;" />
                        <TextBlock Text="{Binding CheckButtonText}" />
                    </StackPanel>
                </Button>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="132"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="查看并更新"
                            Click="OpenUpdateButton_Click"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Width="96"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="关闭"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
