<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>STM32CubeMX-Chinese-Patcher</AssemblyName>
    <RootNamespace>STM32CubeMX.ChinesePatcher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>STM32CubeMX 汉化工具</Product>
    <Description>STM32CubeMX 中文界面补丁管理工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\STM32CubeMX.ChinesePatcher.Core\STM32CubeMX.ChinesePatcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Payload\stm32cubemx-zh-agent.jar" LogicalName="STM32CubeMX.ChinesePatcher.Payload.stm32cubemx-zh-agent.jar" />
    <EmbeddedResource Include="Resources\Payload\translations.tsv" LogicalName="STM32CubeMX.ChinesePatcher.Payload.translations.tsv" />
  </ItemGroup>

</Project>
